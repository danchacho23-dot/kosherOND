# ---------------------------------------------------------------------------
# KosherOnDemand — variables de entorno
# Copiá este archivo a .env.local y completá los valores.
# Nunca commitees .env ni .env.local.
# ---------------------------------------------------------------------------

# --- Base de datos (obligatoria) -------------------------------------------
# Postgres gestionado: Neon o Supabase.
# Neon: agregá ?sslmode=require
DATABASE_URL="postgresql://usuario:password@host:5432/kosherondemand?sslmode=require"

# --- Autenticación de admin (obligatoria) ----------------------------------
# Generá el secreto con: openssl rand -base64 32
AUTH_SECRET="cambiame-por-un-secreto-de-32-bytes"

# Emails con acceso al panel, separados por coma. Nadie más recibe enlace de
# acceso ni puede canjear uno. Esta es la única lista de control de acceso.
ADMIN_EMAILS="vos@ejemplo.com,socio@ejemplo.com"

# Solo hace falta si el host no se detecta solo (fuera de Vercel).
# AUTH_URL="https://kosherondemand.com"

# --- Email transaccional ----------------------------------------------------
# Un proveedor único, sin cola ni reintentos. Sin esto, en desarrollo los
# emails se imprimen en la consola del servidor; en producción no se envían.
RESEND_API_KEY=""
EMAIL_FROM="KosherOnDemand <hola@kosherondemand.com>"

# Destino de los avisos internos: solicitud nueva y supervisión por vencer.
ADMIN_NOTIFICATION_EMAIL="vos@ejemplo.com"

# --- Almacenamiento privado de documentos de certificación ------------------
# Bucket PRIVADO compatible con S3 (Cloudflare R2). Los documentos de
# supervisión kosher no tienen URL pública: se sirven por /admin/documentos/[id],
# que exige sesión de admin.
#
# Los logos y portadas NO van acá: son URLs públicas que carga el admin.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET="kosherondemand-certificaciones"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# --- Sitio ------------------------------------------------------------------
# URL canónica. Se usa en metadata, Open Graph, sitemap y links de email.
# En Vercel se detecta sola; definila igual para producción.
NEXT_PUBLIC_SITE_URL="https://kosherondemand.com"

# --- Cron -------------------------------------------------------------------
# Protege /api/cron/supervisiones. Vercel lo manda como Authorization: Bearer.
CRON_SECRET=""

# --- Tests e2e (solo local/CI) ----------------------------------------------
# Los e2e BORRAN la base que les indiques. Nunca apuntes esto a producción.
# E2E_PORT="3100"
# PLAYWRIGHT_CHROMIUM_PATH="/ruta/a/chromium"   # si ya tenés uno instalado
