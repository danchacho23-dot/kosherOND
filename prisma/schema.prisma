// KosherOnDemand — MVP Fase 1
// Directorio kosher de Panamá. Sin pedidos nativos, sin pagos, sin portal de comercio.
// Todo el dinero se mueve fuera de la plataforma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
}

/// Ciclo de vida del comercio publicado.
/// DRAFT: cargado por admin, todavía no visible al público.
enum MerchantStatus {
  DRAFT
  APPROVED
  SUSPENDED
}

/// Ciclo de vida de la solicitud pública: Submitted → Under review → Approved | Rejected
enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

/// Clasificación kosher declarativa del comercio. No es una afirmación de supervisión.
enum DietTag {
  MEAT
  DAIRY
  PAREVE
  MIXED
}

/// Cómo continúa el cliente el pedido. Siempre fuera de la plataforma.
enum OrderChannel {
  WHATSAPP
  WEBSITE
  PHONE
  PICKUP
}

enum AnalyticsEventType {
  HOME_VIEW
  DIRECTORY_VIEW
  SEARCH
  FILTER_USE
  MERCHANT_VIEW
  WHATSAPP_CLICK
  WEBSITE_CLICK
  PHONE_CLICK
  DIRECTIONS_CLICK
  APPLICATION_SUBMITTED
}

// ---------------------------------------------------------------------------
// Auth (solo administradores) — modelos requeridos por Auth.js / Prisma adapter
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(ADMIN)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  adminActions         AdminActionLog[]
  reviewedApplications MerchantApplication[] @relation("ApplicationReviewer")
  verifiedSupervisions KosherSupervision[]   @relation("SupervisionVerifier")
  uploadedDocuments    CertificationDocument[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Taxonomía
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  /// Nombre de ícono lucide-react, resuelto en el cliente.
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isSeedData  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchants Merchant[]

  @@index([isActive, sortOrder])
}

model Neighborhood {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  isSeedData Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchants Merchant[]

  @@index([isActive, sortOrder])
}

// ---------------------------------------------------------------------------
// Comercio
// ---------------------------------------------------------------------------

model Merchant {
  id       String @id @default(cuid())
  /// Identificador público no secuencial, usado en links de atribución.
  publicId String @unique
  slug     String @unique

  legalName   String
  name        String
  description String? @db.Text
  tagline     String?

  contactName    String
  phone          String
  whatsappPhone  String?
  email          String

  categoryId     String
  neighborhoodId String

  addressLine String
  addressNote String?
  latitude    Float?
  longitude   Float?

  /// Cobertura de entrega en texto libre. Sin radios ni polígonos en el MVP.
  deliveryAreaText String?
  offersDelivery   Boolean @default(false)
  offersPickup     Boolean @default(true)

  dietTag DietTag?
  tags    String[] @default([])

  // Canales de pedido externo — la plataforma nunca toma el pedido.
  orderChannels OrderChannel[] @default([])
  websiteUrl    String?
  /// Mensaje base para el deep link de WhatsApp. Si es null se usa el copy por defecto.
  whatsappGreeting String?

  logoUrl  String?
  coverUrl String?

  // Motor de horarios
  timezone                    String @default("America/Panama")
  /// Minutos ANTES del encendido de velas en que el comercio cierra.
  shabbatCloseOffsetMinutes   Int    @default(90)
  /// Minutos DESPUÉS de havdalá en que el comercio reabre.
  havdalahReopenOffsetMinutes Int    @default(60)
  /// Si es false, el comercio no cierra automáticamente por Shabat/jaguim.
  observesShabbat             Boolean @default(true)

  status     MerchantStatus @default(DRAFT)
  isFeatured Boolean        @default(false)
  sortWeight Int            @default(0)

  /// Texto normalizado (minúsculas, sin acentos) para búsqueda full-text.
  searchText String @default("")

  isSeedData Boolean   @default(false)
  publishedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category     Category     @relation(fields: [categoryId], references: [id])
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id])

  hours       MerchantHours[]
  closures    HolidayClosure[]
  supervision KosherSupervision?
  products    Product[]
  events      AnalyticsEvent[]
  application MerchantApplication?

  @@index([status, deletedAt])
  @@index([categoryId, status])
  @@index([neighborhoodId, status])
  @@index([status, isFeatured, sortWeight])
}

/// Horario semanal. Varias filas por día permiten turnos partidos.
model MerchantHours {
  id         String @id @default(cuid())
  merchantId String
  /// 0 = domingo … 6 = sábado (coincide con Date#getDay).
  dayOfWeek  Int
  /// Minutos desde medianoche, hora local del comercio.
  opensAt    Int
  closesAt   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, dayOfWeek])
}

/// Cierre puntual cargado a mano: vacaciones, remodelación, jag propio del comercio.
model HolidayClosure {
  id         String   @id @default(cuid())
  merchantId String
  startsAt   DateTime
  endsAt     DateTime
  reason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, startsAt, endsAt])
}

// ---------------------------------------------------------------------------
// Supervisión kosher — conservador por defecto.
// La sola existencia de una fila activa significa "verificado por admin".
// Sin fila activa, la página pública no dice absolutamente nada sobre supervisión.
// ---------------------------------------------------------------------------

model KosherSupervision {
  id         String @id @default(cuid())
  merchantId String @unique

  /// Autoridad certificante. Ver OPEN_DECISIONS.md — qué autoridad valida sigue abierto.
  authority     String
  certificateId String?
  verifiedAt    DateTime
  expiresAt     DateTime?
  notes         String?  @db.Text

  /// Permite revocar sin borrar el historial.
  isActive         Boolean @default(true)
  verifiedByUserId String?

  /// Marca puesta por el job de alerta para no re-notificar el mismo vencimiento.
  expiryNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant   Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  verifiedBy User?                   @relation("SupervisionVerifier", fields: [verifiedByUserId], references: [id])
  documents  CertificationDocument[]

  @@index([isActive, expiresAt])
}

/// Documento de certificación. Almacenamiento PRIVADO, nunca servido públicamente.
model CertificationDocument {
  id            String @id @default(cuid())
  supervisionId String

  /// Clave en el bucket privado. No es una URL pública.
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int

  uploadedByUserId String?
  createdAt        DateTime @default(now())

  supervision KosherSupervision @relation(fields: [supervisionId], references: [id], onDelete: Cascade)
  uploadedBy  User?             @relation(fields: [uploadedByUserId], references: [id])

  @@index([supervisionId])
}

// ---------------------------------------------------------------------------
// Catálogo informativo (opcional por comercio)
// ---------------------------------------------------------------------------

model Product {
  id          String  @id @default(cuid())
  merchantId  String
  name        String
  description String?
  /// Centavos. Moneda fija PAB (paridad con USD). Sin modificadores ni stock.
  priceCents  Int?
  dietTag     DietTag?
  sortOrder   Int     @default(0)
  isSeedData  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, sortOrder])
}

// ---------------------------------------------------------------------------
// Alta de comercios
// ---------------------------------------------------------------------------

model MerchantApplication {
  id       String @id @default(cuid())
  publicId String @unique

  legalName     String
  name          String
  contactName   String
  phone         String
  whatsappPhone String?
  email         String

  categoryId       String?
  categorySlug     String?
  neighborhoodId   String?
  neighborhoodSlug String?

  addressLine      String
  description      String? @db.Text
  deliveryAreaText String?
  offersDelivery   Boolean @default(false)
  offersPickup     Boolean @default(true)
  dietTag          DietTag?

  orderChannels OrderChannel[] @default([])
  websiteUrl    String?
  logoUrl       String?
  coverUrl      String?

  /// Horario semanal tal como lo envió el solicitante, sin normalizar.
  hoursPayload Json?

  status           ApplicationStatus @default(SUBMITTED)
  reviewNotes      String?           @db.Text
  rejectionReason  String?           @db.Text
  reviewedByUserId String?
  reviewedAt       DateTime?

  /// Comercio creado a partir de esta solicitud, si fue aprobada.
  merchantId String? @unique

  /// Hash del IP + user agent. Solo para rate limiting, no identifica a nadie.
  submitterHash String?

  isSeedData Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  reviewedBy User?     @relation("ApplicationReviewer", fields: [reviewedByUserId], references: [id])

  @@index([status, createdAt])
  @@index([submitterHash, createdAt])
}

// ---------------------------------------------------------------------------
// Analítica y auditoría
// ---------------------------------------------------------------------------

/// Eventos sin datos personales. Nada acá permite reconstruir quién hizo qué.
model AnalyticsEvent {
  id         String             @id @default(cuid())
  type       AnalyticsEventType
  merchantId String?
  /// Término de búsqueda normalizado.
  searchTerm String?
  filterKey   String?
  filterValue String?
  path        String?
  metadata    Json?
  createdAt   DateTime @default(now())

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([merchantId, type, createdAt])
  @@index([createdAt])
}

model AdminActionLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String
  action      String
  entityType  String
  entityId    String
  previousValue Json?
  newValue      Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}
